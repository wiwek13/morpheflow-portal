{
  "name": "morpheflow",
  "version": "2.4.4",
  "description": "MorpheFlow edge management portal and build distribution on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "build": "echo 'Static assets ready in web/frontend'",
    "dev": "wrangler dev",
    "dev:kv": "wrangler dev -c wrangler.kv.toml",
    "deploy": "node scripts/deploy-cf.cjs",
    "deploy:kv": "node scripts/deploy-cf.cjs --kv",
    "deploy:raw": "wrangler deploy",
    "bump": "node scripts/bump-version.cjs",
    "bump:patch": "node scripts/bump-version.cjs patch",
    "bump:minor": "node scripts/bump-version.cjs minor",
    "bump:major": "node scripts/bump-version.cjs major",
    "version:sync": "node scripts/bump-version.cjs sync",
    "types:check": "tsc --noEmit",
    "test": "node --test 'tests/**/*.test.js'"
  },
  "keywords": [
    "morpheflow",
    "morphe",
    "revanced",
    "android",
    "apk-patcher",
    "cloudflare-workers",
    "d1",
    "serverless"
  ],
  "author": "holjab",
  "license": "GPL-3.0",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@resvg/resvg-js": "^2.6.2",
    "typescript": "^5.7.3",
    "wrangler": "^3.111.0"
  }
}
